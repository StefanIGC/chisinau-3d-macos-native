{
  "name": "chisinau-3d-macos",
  "version": "1.3.0",
  "private": true,
  "description": "Joc 3D open-world al centrului Chișinăului pentru macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test:columna": "node scripts/test-columna-ismail-tighina.mjs",
    "package:mac": "npm run build:web && electron-packager . 'Chisinau 3D' --platform=darwin --arch=universal --out=release --overwrite --prune=true --no-asar --download.cacheRoot=../electron-cache --app-bundle-id=md.chisinau.game.v130 --app-category-type=public.app-category.games --app-version=1.3.0 --build-version=6 --icon=build/AppIcon.icns --ignore='^/(app|components|data|hooks|lib|public|vendor|build|release[^/]*|src|node_modules|scripts|ASSETS\\.md|index\\.html|postcss\\.config\\.mjs|tsconfig\\.json|vite\\.config\\.ts)($|/)'",
    "start": "electron ."
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "pbf": "^5.1.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
